# Required bootstrap settings
BASE_URL=https://aio.example.com
SECRET_KEY=replace_with_a_64_character_hex_string
DATABASE_URI=sqlite://./data/db.sqlite

# Local operator account
AIOSTREAMS_AUTH=admin:replace_with_a_strong_password
AIOSTREAMS_AUTH_PERMISSIONS=admin=admin

# Require a login for the configuration page and protect config writes.
AIOSTREAMS_AUTH_REQUIRED=true

# Permit regex configurations and remote regex sources on this private instance.
REGEX_FILTER_ACCESS=all

# Recommended container logging format.
LOG_FORMAT=json
